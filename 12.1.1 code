Write a Python program to manage a phone number database using a dictionary. The dictionary stores contact names as keys and phone numbers as values.
n = int(input().strip())

contacts = {}

for _ in range(n):
    operation = input().strip().split()

    if operation[0] == "ADD":
        name = operation[1]
        phone = operation[2]
        contacts[name] = phone   # Add or update

    elif operation[0] == "REMOVE":
        name = operation[1]
        contacts.pop(name, None)  # Remove if exists, ignore if not

    elif operation[0] == "DISPLAY":
        if not contacts:
            print("No contacts")
        else:
            for name in sorted(contacts):
                print(f"{name}: {contacts[name]}")
